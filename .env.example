# Copy to .env.local for local work; set the same names in the host's environment in production.
# Every value here is server-only except NEXT_PUBLIC_SITE_URL. Never put a secret in a NEXT_PUBLIC_ variable.

# --- Site ------------------------------------------------------------------------------------
# Public URL of this deployment (canonical links, sitemap, structured data). Leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Search engines are blocked unless this is exactly "true". Set it only for the approved launch.
SITE_ALLOW_INDEXING=false

# --- Enquiry form delivery: configure ONE option -----------------------------------------------
# Without either, the form tells visitors their message was not sent and to email instead.
# Option A: Resend email. All three are required together.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
# Option B: HTTPS webhook (CRM, Zapier, Make...). Used only when Option A is not configured.
ENQUIRY_WEBHOOK_URL=
# Optional; sent as "Authorization: Bearer <secret>".
ENQUIRY_WEBHOOK_SECRET=

# --- CMS / admin panel (MySQL 8 or MariaDB 10.6+) -------------------------------------------------
# Leave DATABASE_URL empty to run the public site on its built-in content with the admin disabled.
# When it is set, the database must be reachable during `npm run build` as well as at runtime.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE (URL-encode special characters in the password).
DATABASE_URL=mysql://siccotel:change-me@127.0.0.1:3306/siccotel
# "true" when the database host requires TLS (most remote hosts).
DATABASE_SSL=false
# Folder for uploaded images. Must persist across deploys; keep it outside the deploy folder in production.
UPLOAD_DIR=storage/uploads

# Local plain-HTTP testing only (npm start on http://localhost): lets the admin session cookie work
# without HTTPS. NEVER set this on a public server.
# INSECURE_LOCAL_COOKIES=true

# Optional: build into another folder than .next, e.g. to run a second test instance beside the first.
# NEXT_DIST_DIR=.next-test
