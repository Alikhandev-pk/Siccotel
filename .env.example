# Public URL of this deployment; leave unset during local development.
NEXT_PUBLIC_SITE_URL=
SITE_ALLOW_INDEXING=false

# Option A: Resend. All three values must be configured together.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Option B: HTTPS webhook. Used when Resend is not configured.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# CMS and admin panel (MySQL / MariaDB). See docs/ADMIN_SETUP.md. Server-only: never prefix with NEXT_PUBLIC_.
# Local demo (MySQL 8.4 on port 3308): mysql://siccotel:change-me@127.0.0.1:3308/siccotel
# Old MariaDB demo (rollback): mysql://siccotel:change-me@127.0.0.1:3306/siccotel
# Hostinger:    mysql://u123456789_siccotel:change-me@srv000.hstgr.io:3306/u123456789_siccotel
DATABASE_URL=mysql://siccotel:change-me@127.0.0.1:3306/siccotel
# Set to true when the database host requires TLS.
DATABASE_SSL=false
# Uploaded images (persistent, gitignored). Defaults to storage/uploads.
UPLOAD_DIR=storage/uploads
