# Public URL of this deployment; leave unset during local development.
NEXT_PUBLIC_SITE_URL=
SITE_ALLOW_INDEXING=false

# Option A: Resend. All three values must be configured together.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Option B: HTTPS webhook. Used when Resend is not configured.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
